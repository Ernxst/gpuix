{
  "name": "@gpuix/plugins",
  "version": "0.19.0-fork.1",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js",
      "default": "./dist/bun.js"
    },
    "./css-modules": {
      "types": "./dist/css-modules-types.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ernxst/gpuix.git"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuix/plugins locally. CI is the only release path. See AGENTS.md.'); process.exit(1) }\"",
    "build": "tsc && bun scripts/copy-css-modules-types.ts",
    "prepack": "bun run build",
    "test": "bun test src/spike.test.ts src/css-modules.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@gpuix/react": "0.19.0-fork.1",
    "vite": "^8.2.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "css-to-react-native-transform": "^2.1.0",
    "postcss": "^8.5.28",
    "react-refresh": "^0.18.0",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@gpuix/react": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "react": "^19.2.4",
    "vite": "^8.2.1"
  }
}
