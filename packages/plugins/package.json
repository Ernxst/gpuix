{
  "name": "@gpuix/plugins",
  "version": "0.25.0-fork.4",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js",
      "default": "./dist/bun.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js",
      "default": "./dist/css.js"
    },
    "./preload": "./dist/preload.js",
    "./css-modules": {
      "types": "./dist/css-modules-types.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ernxst/gpuix.git"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuix/plugins locally. CI is the only release path. See AGENTS.md.'); process.exit(1) }\"",
    "build": "tsc && bun scripts/copy-css-modules-types.ts",
    "prepack": "bun run build",
    "test": "bun test src/css.test.ts src/css-modules.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@gpuix/react": "0.25.0-fork.4",
    "vite": "^8.2.1"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "css-to-react-native-transform": "^2.1.0",
    "postcss": "^8.5.28",
    "postcss-custom-properties": "^15.0.1",
    "postcss-import": "^17.0.0",
    "postcss-nesting": "^14.0.1",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@gpuix/react": "workspace:*",
    "@types/postcss-import": "^14.0.3",
    "react": "^19.2.4",
    "vite": "^8.2.1"
  }
}
