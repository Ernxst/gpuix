{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    // Inputs name what Cargo compiles. An edit to the README, the Rust examples
    // or the browser files leaves the addon's hash alone. The submodule's `.git`
    // file holds a path that differs in every worktree, so it stays out, or no
    // two worktrees would share a build.
    "build": {
      "inputs": [
        "src/**",
        "build.rs",
        "Cargo.toml",
        "Cargo.lock",
        ".cargo/**",
        ".mbx.toml",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/zed/**",
        "!$TURBO_ROOT$/zed/.git",
        "!$TURBO_ROOT$/zed/**/.DS_Store",
        "!**/.DS_Store"
      ],
      "outputs": [
        "dist/*"
      ],
      // Hashed: what changes the binary. The runner pair stands in for the
      // target, which turbo does not hash.
      "env": [
        "RUNNER_OS",
        "RUNNER_ARCH",
        "CARGO*",
        "!CARGO",
        "!CARGO_HOME",
        "!CARGO_TARGET_DIR",
        "RUST*",
        "!RUSTUP_HOME",
        "!RUSTC_WRAPPER",
        "!RUSTC_WORKSPACE_WRAPPER",
        "CC*",
        "CXX*",
        "AR*",
        "CFLAGS*",
        "CXXFLAGS*",
        "CPPFLAGS*",
        "LDFLAGS*",
        "MACOSX_*",
        "IPHONEOS_*",
        "DEPLOYMENT_TARGET*",
        "VCToolsVersion",
        "WindowsSDKVersion",
        "ZIG*",
        "NAPI_RS_*"
      ],
      // Passed through but not hashed: where the toolchain and SDKs live on
      // this machine. Hashing them would stop two runners sharing a build.
      "passThroughEnv": [
        "CARGO",
        "RUSTC_WRAPPER",
        "RUSTC_WORKSPACE_WRAPPER",
        "MBX_*",
        "CARGO_HOME",
        "CARGO_TARGET_DIR",
        "RUSTUP_HOME",
        "SDKROOT",
        "DEVELOPER_DIR",
        "VCTOOLS*",
        "WINDOWSSDK*",
        "WindowsSdkDir",
        "INCLUDE",
        "LIB",
        "PKG_CONFIG*",
        "VCPKG*",
        "GPUI_FXC_PATH"
      ]
    },
    // The same build without `test-support`. Keep its inputs and environment
    // in step with `build`.
    "build:release": {
      "inputs": [
        "src/**",
        "build.rs",
        "Cargo.toml",
        "Cargo.lock",
        ".cargo/**",
        ".mbx.toml",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/zed/**",
        "!$TURBO_ROOT$/zed/.git",
        "!$TURBO_ROOT$/zed/**/.DS_Store",
        "!**/.DS_Store"
      ],
      "outputs": [
        "dist/*"
      ],
      "env": [
        "RUNNER_OS",
        "RUNNER_ARCH",
        "CARGO*",
        "!CARGO",
        "!CARGO_HOME",
        "!CARGO_TARGET_DIR",
        "RUST*",
        "!RUSTUP_HOME",
        "!RUSTC_WRAPPER",
        "!RUSTC_WORKSPACE_WRAPPER",
        "CC*",
        "CXX*",
        "AR*",
        "CFLAGS*",
        "CXXFLAGS*",
        "CPPFLAGS*",
        "LDFLAGS*",
        "MACOSX_*",
        "IPHONEOS_*",
        "DEPLOYMENT_TARGET*",
        "VCToolsVersion",
        "WindowsSDKVersion",
        "ZIG*",
        "NAPI_RS_*"
      ],
      "passThroughEnv": [
        "CARGO",
        "RUSTC_WRAPPER",
        "RUSTC_WORKSPACE_WRAPPER",
        "MBX_*",
        "CARGO_HOME",
        "CARGO_TARGET_DIR",
        "RUSTUP_HOME",
        "SDKROOT",
        "DEVELOPER_DIR",
        "VCTOOLS*",
        "WINDOWSSDK*",
        "WindowsSdkDir",
        "INCLUDE",
        "LIB",
        "PKG_CONFIG*",
        "VCPKG*",
        "GPUI_FXC_PATH"
      ]
    },
    // GPUI's own suite, which the fork's patches to `zed` can break. It takes
    // minutes, so it is a task of its own and `test` leaves it out. It reruns
    // when the submodule changes.
    "test:gpui": {
      "inputs": [
        "$TURBO_ROOT$/zed/**",
        "!$TURBO_ROOT$/zed/.git",
        "!$TURBO_ROOT$/zed/**/.DS_Store"
      ],
      "outputs": [],
      "env": [
        "RUNNER_OS",
        "RUNNER_ARCH",
        "CARGO*",
        "!CARGO",
        "!CARGO_HOME",
        "!CARGO_TARGET_DIR",
        "RUST*",
        "!RUSTUP_HOME",
        "MACOSX_*"
      ],
      "passThroughEnv": [
        "CARGO",
        "CARGO_HOME",
        "CARGO_TARGET_DIR",
        "RUSTUP_HOME",
        "SDKROOT",
        "DEVELOPER_DIR"
      ],
      "description": "Run GPUI's own tests in the zed submodule."
    },
    "build:debug": {
      "cache": false,
      "inputs": [
        "src/**",
        "build.rs",
        "Cargo.toml",
        "Cargo.lock",
        ".cargo/**",
        ".mbx.toml",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/zed/**",
        "!$TURBO_ROOT$/zed/.git",
        "!$TURBO_ROOT$/zed/**/.DS_Store",
        "!**/.DS_Store"
      ],
      "passThroughEnv": [
        "*"
      ],
      "description": "Build the addon unoptimised, for the dev loop."
    }
  }
}
