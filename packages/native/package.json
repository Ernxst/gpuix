{
  "name": "@gpuix/native",
  "version": "0.26.1-fork",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "browser.mjs",
  "napi": {
    "binaryName": "gpuix-native",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxiajs/gpuix.git"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --output-dir dist --features test-support",
    "build:release": "napi build --platform --release --output-dir dist --no-default-features",
    "build:test-fault-injection": "napi build --platform --release --output-dir dist --features \"test-support display-discovery-fault-injection\"",
    "build:debug": "napi build --platform --output-dir dist --features test-support",
    "test:gpui": "cd ../../zed && cargo test -p gpui",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuix/native locally. CI builds all platform binaries. See AGENTS.md.'); process.exit(1) }\" && bun ../../scripts/web.ts --build-only && napi pre-publish -t npm --no-gh-release",
    "universal": "napi universal",
    "version": "napi version",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.5.1"
  },
  "files": [
    "dist",
    "browser.mjs",
    "wasm",
    "LICENSE"
  ]
}
