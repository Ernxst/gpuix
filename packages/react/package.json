{
  "name": "@gpuix/react",
  "version": "0.6.0-fork.3",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "import": "./jsx-runtime.js",
      "default": "./jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts",
      "import": "./jsx-dev-runtime.js",
      "default": "./jsx-dev-runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./select": {
      "types": "./dist/components/select.d.ts",
      "import": "./dist/components/select.js",
      "default": "./dist/components/select.js"
    },
    "./combobox": {
      "types": "./dist/components/combobox.d.ts",
      "import": "./dist/components/combobox.js",
      "default": "./dist/components/combobox.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/components/tooltip.js",
      "default": "./dist/components/tooltip.js"
    },
    "./automation": {
      "types": "./dist/automation/index.d.ts",
      "import": "./dist/automation/index.js",
      "default": "./dist/automation/index.js"
    }
  },
  "files": [
    "dist",
    "canvas-goldens",
    "jsx-runtime.js",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.js",
    "jsx-dev-runtime.d.ts",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/remorses/gpuix"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuix/react locally. CI is the only release path. See AGENTS.md.'); process.exit(1) }\"",
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit && bun run typecheck:test",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "dev": "tsc --watch",
    "test": "bun run build && bun run typecheck:test && vitest run --exclude src/__tests__/canvas-wpt.test.tsx",
    "canvas:wpt": "vitest run src/__tests__/canvas-wpt.test.tsx",
    "test:watch": "bun run build && vitest --exclude src/__tests__/canvas-wpt.test.tsx",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@gpuix/native": "workspace:^",
    "eventsource-parser": "^4.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-reconciler": "^0.31.0",
    "scheduler": "^0.25.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "1.170.32",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-reconciler": "^0.28.0",
    "react-reconciler": "^0.31.0",
    "scheduler": "^0.25.0",
    "react-refresh": "^0.18.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
