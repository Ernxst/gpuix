{
  "name": "@gpuix/react",
  "version": "0.26.1-fork",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js",
      "default": "./dist/cn.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "import": "./jsx-runtime.js",
      "default": "./jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts",
      "import": "./jsx-dev-runtime.js",
      "default": "./jsx-dev-runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./testing/vitest": {
      "types": "./dist/testing-vitest.d.ts",
      "import": "./dist/testing-vitest.js",
      "default": "./dist/testing-vitest.js"
    },
    "./testing/matchers": {
      "types": "./dist/testing-expect.d.ts",
      "import": "./dist/testing-expect.js",
      "default": "./dist/testing-expect.js"
    },
    "./select": {
      "types": "./dist/components/select.d.ts",
      "import": "./dist/components/select.js",
      "default": "./dist/components/select.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog.d.ts",
      "import": "./dist/components/dialog.js",
      "default": "./dist/components/dialog.js"
    },
    "./alert-dialog": {
      "types": "./dist/components/alert-dialog.d.ts",
      "import": "./dist/components/alert-dialog.js",
      "default": "./dist/components/alert-dialog.js"
    },
    "./combobox": {
      "types": "./dist/components/combobox.d.ts",
      "import": "./dist/components/combobox.js",
      "default": "./dist/components/combobox.js"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip.d.ts",
      "import": "./dist/components/tooltip.js",
      "default": "./dist/components/tooltip.js"
    },
    "./floating": {
      "types": "./dist/floating.d.ts",
      "import": "./dist/floating.js",
      "default": "./dist/floating.js"
    },
    "./dialogs": {
      "types": "./dist/dialogs.d.ts",
      "import": "./dist/dialogs.js",
      "default": "./dist/dialogs.js"
    },
    "./globals": {
      "types": "./dist/globals.d.ts",
      "import": "./dist/globals.js",
      "default": "./dist/globals.js"
    },
    "./automation": {
      "types": "./dist/automation/index.d.ts",
      "import": "./dist/automation/index.js",
      "default": "./dist/automation/index.js"
    }
  },
  "files": [
    "dist",
    "goldens/canvas",
    "jsx-runtime.js",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.js",
    "jsx-dev-runtime.d.ts",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxiajs/gpuix.git"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuix/react locally. CI is the only release path. See AGENTS.md.'); process.exit(1) }\"",
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --build tsconfig.typecheck.json --noEmit",
    "dev": "tsc --watch --incremental",
    "test": "vitest run --project react",
    "canvas:wpt": "vitest run --project wpt",
    "test:watch": "vitest --project react",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@gpuix/native": "0.26.1-fork",
    "cn": "0.4.0",
    "eventsource-parser": "4.1.0",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "scheduler": "^0.27.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "scheduler": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-router": "1.170.32",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.3.3",
    "@types/react": "19.2.18",
    "@types/react-reconciler": "0.28.9",
    "@webgpu/types": "0.1.74",
    "react-reconciler": "0.33.0",
    "react-refresh": "0.18.0",
    "scheduler": "0.27.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
