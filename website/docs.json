{
  "$schema": "https://holocron.so/docs.json",
  "name": "GPUIX",
  "description": "GPUI and React for native apps. GPUIX paints a React tree with GPUI, Zed's GPU UI framework.",
  "colors": {
    "primary": "#f97316"
  },
  "appearance": {
    "default": "system"
  },
  "layout": {
    "mode": "compact"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/galaxiajs/gpuix"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "lucide:book-open",
        "groups": [
          {
            "group": "Overview",
            "icon": "lucide:home",
            "pages": ["index"]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "lucide:newspaper",
        "changelog": "https://github.com/galaxiajs/gpuix",
        "initialContent": "changelog/intro"
      },
      {
        "tab": "GitHub",
        "icon": "lucide:github",
        "href": "https://github.com/galaxiajs/gpuix"
      },
      {
        "tab": "npm (upstream)",
        "icon": "lucide:package",
        "href": "https://www.npmjs.com/package/@gpuix/react"
      }
    ]
  },
  "decorativeLines": "none"
}
