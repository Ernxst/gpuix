{
  "name": "gpuix",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples",
    "example-app"
  ],
  "scripts": {
    "-------------------------------------------------------------------------------": "",
    "dev": "turbo watch dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "--------------------------------------------------------------------------------": "",
    "lint:monorepo": "sherif -i typescript@5.9.3",
    "lint:dependencies": "syncpack lint",
    "---------------------------------------------------------------------------------": "",
    "test": "turbo run test --concurrency=1",
    "test:watch": "vitest --project '!*(perf)' --project '!*(wpt)'",
    "test:coverage": "vitest run --coverage --project '!*(perf)' --project '!*(wpt)'",
    "----------------------------------------------------------------------------------": ""
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@vitest/coverage-istanbul": "5.0.3",
    "react": "19.2.4",
    "react-reconciler": "0.33.0",
    "react-refresh": "0.18.0",
    "sherif": "1.13.0",
    "syncpack": "15.3.3",
    "turbo": "2.11.6",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  }
}
